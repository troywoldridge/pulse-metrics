# APP_URL: URL where the application is hosted.
APP_URL="http://localhost:3000"

# Application runtime connection.
# Use the dedicated, non-owner application role.
DATABASE_URL=postgresql://pulse_metrics_app:CHANGE_ME@127.0.0.1:5432/pulse_metrics

# Schema migration connection.
# Use only for Drizzle migrations, never for the running API.
MIGRATION_DATABASE_URL=postgresql://pulse_metrics_migrator:CHANGE_ME@127.0.0.1:5432/pulse_metrics

# Optional runtime connection pool size (default: 10).
DATABASE_POOL_MAX=10

# Runtime settings.
NODE_ENV=development
PORT=3000
