# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio may inject this at runtime from configured user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where the app is hosted.
APP_URL="MY_APP_URL"

# Application runtime connection. This role must be a dedicated, non-owner,
# non-superuser role with no BYPASSRLS attribute and only required table grants.
DATABASE_URL=postgresql://pulse_metrics_app:CHANGE_ME@127.0.0.1:5432/pulse_metrics

# Schema migration connection. This is a separate, tightly controlled role
# permitted to own/manage schema objects. Never use it in the running API.
MIGRATION_DATABASE_URL=postgresql://pulse_metrics_migrator:CHANGE_ME@127.0.0.1:5432/pulse_metrics

# Optional runtime connection pool size (default: 10).
DATABASE_POOL_MAX=10

# Runtime settings.
NODE_ENV=development
PORT=3000
